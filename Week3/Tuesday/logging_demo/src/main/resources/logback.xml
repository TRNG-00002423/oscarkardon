<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Define the properties for the log file path and name -->
    <property name="LOG_DIR" value="logs" />
    <property name="LOG_FILE" value="app" />

    <!-- 1. Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %highlight(%-5level) %cyan(%logger{36}) - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- 2. Rolling File Appender -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <!-- Current active log file -->
        <file>${LOG_DIR}/${LOG_FILE}.log</file>
        
        <!-- Rollover policy: Daily rollover with size capping -->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- Archive file name pattern (e.g., logs/app.2026-06-16.log) -->
            <fileNamePattern>${LOG_DIR}/${LOG_FILE}.%d{yyyy-MM-dd}.log</fileNamePattern>
            
            <!-- Keep 30 days worth of history -->
            <maxHistory>30</maxHistory>
            
            <!-- Total size cap of all archive files combined -->
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <!-- Standard log pattern (no colors for file output to keep clean text) -->
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root logger configuration utilizing both appenders -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>

</configuration>
